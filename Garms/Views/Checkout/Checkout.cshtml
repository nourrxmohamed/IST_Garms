@model Garms.Models.Customers

@{
    ViewData["Title"] = "Checkout";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] | GARMS</title>

    <link rel="stylesheet"
          href="~/css/shop.css">

</head>

<body>

    <!-- =====================================================
         ANNOUNCEMENT
    ====================================================== -->

    <div class="announcement">
        NEW DROP ON FRIDAY — FIND YOUR NEXT PIECE
    </div>


    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <nav class="shop-nav"
         aria-label="Main navigation">

        <a class="logo"
           href="/">
            GARMS
        </a>

        <div class="nav-links">

            <a href="/Wishlist/Wishlist">
                ♡ <span id="wishlistCount">0</span>
            </a>

            <a href="/Cart/Cart">
                CART (<span id="cartCount">0</span>)
            </a>

        </div>

    </nav>


    <!-- =====================================================
         CHECKOUT
    ====================================================== -->

    <main class="shop-page">

        <p class="eyebrow">
            GARMS / CHECKOUT
        </p>

        <h1>
            Make it yours.
        </h1>


        <div class="checkout">


            <!-- =================================================
                 DELIVERY FORM
            ================================================== -->

            <form id="checkoutForm"
                  class="checkout-card"
                  asp-controller="Checkout"
                  asp-action="Create"
                  method="post">


                <h2>
                    Delivery details
                </h2>


                <!-- FULL NAME -->

                <label for="name">
                    Full name
                </label>

                <input id="name"
                       name="FullName"
                       autocomplete="name"
                       required>


                <!-- EMAIL -->

                <label for="email">
                    Email
                </label>

                <input id="email"
                       name="Email"
                       type="email"
                       autocomplete="email"
                       required>


                <!-- ADDRESS -->

                <label for="address">
                    Address
                </label>

                <input id="address"
                       name="address"
                       autocomplete="street-address"
                       required>


                <!-- CITY + PHONE -->

                <div class="form-row">

                    <div>

                        <label for="city">
                            City
                        </label>

                        <input id="city"
                               name="city"
                               autocomplete="address-level2"
                               required>

                    </div>


                    <div>

                        <label for="phone">
                            Phone
                        </label>

                        <input id="phone"
                               name="Phone"
                               type="tel"
                               autocomplete="tel"
                               required>

                    </div>

                </div>


                <!-- SUBMIT -->

                <button class="button-green"
                        type="submit"
                        style="width: 100%; margin-top: 28px;">

                    PLACE ORDER

                </button>

            </form>


            <!-- =================================================
                 ORDER SUMMARY
            ================================================== -->

            <aside class="checkout-card">

                <p class="eyebrow">
                    ORDER TOTAL
                </p>

                <h2 id="checkoutTotal">
                    EGP 0
                </h2>

                <p>
                    Your order is reserved once you place it.
                    Payment is handled on delivery.
                </p>

            </aside>


        </div>

    </main>


    <!-- =====================================================
         SHOP JAVASCRIPT
    ====================================================== -->

    <script src="~/js/shop.js"></script>

</body>

</html>