@{
    ViewData["Title"] = "Shop Category";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop Category | GARMS</title>
    <link rel="stylesheet" href="~/css/shop.css">
</head>
<body>
    <div class="announcement">NEW DROP ON FRIDAY — FIND YOUR NEXT PIECE</div>
    <nav class="shop-nav" aria-label="Main navigation">
        <a class="logo" href="/">GARMS</a>
        <div class="nav-links">
            <a href="/Wishlist/Wishlist">♡ <span id="wishlistCount">0</span></a>
            <a href="/Cart/Cart">CART (<span id="cartCount">0</span>)</a>
        </div>
    </nav>
    <main class="shop-page">
        <a class="eyebrow" href="/#drop">← BACK TO SHOP</a>
        <h1 id="categoryTitle">Shop.</h1>
        <div id="productGrid" class="catalogue-grid"></div>
    </main>

    <script src="~/js/shop.js"></script>
    <script src="~/js/category.js"></script>
</body>
</html>