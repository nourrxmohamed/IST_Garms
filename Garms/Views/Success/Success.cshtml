@{
    ViewData["Title"] = "Order Confirmed";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"] | GARMS</title>
  <link rel="stylesheet" href="~/css/shop.css">
</head>
<body>
  <div class="announcement">NEW DROP ON FRIDAY — FIND YOUR NEXT PIECE</div>
  <nav class="shop-nav" aria-label="Main navigation">
    <a class="logo" href="/">GARMS</a>
    <div class="nav-links">
      <a href="/Wishlist/Wishlist">♡ <span id="wishlistCount">0</span></a>
      <a href="/Cart/Cart">CART (<span id="cartCount">0</span>)</a>
    </div>
  </nav>
  <main class="shop-page success">
    <div class="success-mark">✓</div>
    <p class="eyebrow">ORDER CONFIRMED</p>
    <h1>It's on its way.</h1>
    <p>Thank you for shopping with GARMS. We'll send your order details to your email shortly.</p>
    <a class="button button-green" href="/">KEEP SHOPPING</a>
  </main>
  <script src="~/js/shop.js"></script>
</body>
</html>